# Virtual environment (245 MB) -- rebuilt from requirements.txt
.venv/
venv/
env/

# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# PyInstaller output (160 MB) -- the exe belongs on a GitHub release, not in
# the repository. release.py builds it into dist/ and uploads it from there.
build/
dist/
*.manifest

# Runtime state. These are created next to the running program, and
# config.json in particular holds personal settings (window positions, chat
# macros, the client log path) that should not be published.
config.json
config.json.*
*.log

# Trade API data cached next to the program (a few MB, refreshed weekly by
# trade/api.py). Regenerated on demand, and version-specific to the league --
# not something to ship or track.
cache/

# Backups made by the app and by maintenance scripts
*.bak
*.bak-*

# Awakened PoE Trade, unpacked next to this repo as a reference while the
# price check was being rewritten. It is an installed Electron app -- a
# 200 MB exe among 140-odd other files -- and GitHub rejects a push carrying
# it. What this project actually needs from that project is the game data
# under data/trade/, which tools/update_trade_data.py downloads from its
# repository; the installed copy is not a dependency of anything here.
Awakened PoE Trade/

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/
*.swp
